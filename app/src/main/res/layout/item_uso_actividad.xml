<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenidoInterno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="7dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgIconoApp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/fondo_1"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/img_sitio" />

        <TextView
            android:id="@+id/tvNombreApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/titulo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvTiempoUso"
            app:layout_constraintStart_toEndOf="@+id/imgIconoApp"
            app:layout_constraintTop_toTopOf="@+id/imgIconoApp"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/tvCategoriaApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/tvNombreApp"
            app:layout_constraintStart_toStartOf="@+id/tvNombreApp"
            app:layout_constraintTop_toBottomOf="@+id/tvNombreApp"
            tools:text="Redes Sociales" />

        <TextView
            android:id="@+id/tvTiempoUso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/titulo"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imgIconoApp"
            tools:text="2h 15m" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:indicatorColor="@color/primario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgIconoApp"
            app:layout_constraintTop_toBottomOf="@+id/tvCategoriaApp"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="65" />

        <TextView
            android:id="@+id/tvEnUsoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_circulo_primario"
            android:backgroundTint="#4CAF50"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Activo"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/imgIconoApp"
            app:layout_constraintEnd_toEndOf="@+id/imgIconoApp"
            app:layout_constraintStart_toStartOf="@+id/imgIconoApp"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>