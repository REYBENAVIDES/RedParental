<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_1"
    android:padding="24dp">

    <!-- Steps indicator -->
    <LinearLayout
        android:id="@+id/stepsIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_paso_active" />

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginEnd="16dp"
            android:background="@color/primario" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_paso_active" />

        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginEnd="16dp"
            android:background="@color/secondario" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_paso_inactivo" />

    </LinearLayout>

    <!-- Botón reescanear (top right) -->
    <ImageButton
        android:id="@+id/btnRescan"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:backgroundTint="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_recargar"
        app:tint="@color/texto" />

    <!-- Contenedor para animación Lottie (CENTRO) -->
    <LinearLayout
        android:id="@+id/containerScanning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieScanAnimation"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="24dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/scan_wifi" />

        <TextView
            android:id="@+id/tvScanningStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscando dispositivos..."
            android:textColor="@color/titulo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanningDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escaneando redes WiFi cercanas"
            android:textColor="@color/texto"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ViewPager para dispositivos encontrados (oculto inicialmente) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerRouters"
        android:layout_width="0dp"
        android:layout_height="300dp"
        app:layout_constraintBottom_toTopOf="@id/dotsIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepsIndicator" />

    <!-- Indicador de páginas MANUAL -->
    <LinearLayout
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewPagerRouters" />

    <!-- Contenedor para "no encontrado" (oculto inicialmente) -->
    <LinearLayout
        android:id="@+id/containerNoDevices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btnAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepsIndicator">

        <ImageView
            android:id="@+id/ivNoDevices"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/img_dispositivo_no_encontrado" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se encontraron dispositivos"
            android:textColor="@color/titulo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Asegúrate de que el router esté encendido y cerca de tu dispositivo"
            android:textAlignment="center"
            android:textColor="@color/texto"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Botón conectar/reescanear (siempre visible abajo) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="30dp"
        android:text="Conectar Router"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primario"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@id/cardScanInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Card info (siempre visible abajo) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScanInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="@color/fondo_2"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="¿Cómo funciona?"
                android:textColor="@color/titulo"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="• Detección automática vía WiFi\n• Soporte para TP-Link y similares\n• Tiempo estimado: 10-30s"
                android:textColor="@color/texto"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>