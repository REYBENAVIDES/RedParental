<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjetaDispositivo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/fondo_2"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgIconoDispositivo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Icono Dispositivo"
                android:src="@drawable/img_telefono" />

            <View
                android:id="@+id/vistaEstadoConexion"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circulo_primario"
                android:backgroundTint="#4CAF50" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreDispositivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iPhone de Juan"
                    android:textColor="@color/titulo"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/imgNotificacionActiva"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_notificacion"
                    app:tint="@color/primario"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMacDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AA:BB:CC:DD:EE:FF"
                android:textColor="@color/texto"
                android:textSize="12sp"
                android:alpha="0.7"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvInfoConexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Conectado • 2h 15m"
                android:textColor="@color/primario"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_siguiente"
            app:tint="@color/texto"
            android:alpha="0.5" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>