<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RedPaternal" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryVariant">@color/primario_alt</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondario</item>
        <item name="colorSecondaryVariant">@color/secondario_alt</item>
        <item name="colorOnSecondary">@color/titulo</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.RedPaternal.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar"></style>
    <!-- Base application theme. -->
    <style name="Base.Theme.RedPaternal.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="ShapeAppearanceOverlay.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TemaMenuPersonalizado" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">@color/fondo_1</item>
        <item name="android:popupBackground">@color/fondo_1</item>

        <item name="android:textColor">@color/titulo</item>
        <item name="android:textColorPrimary">@color/titulo</item>
    </style>

</resources>
