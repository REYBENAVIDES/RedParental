<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivRouterIcon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/img_dispositivo_general" />

    <TextView
        android:id="@+id/tvRouterName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Mi Router WiFi"
        android:textColor="@color/titulo"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRouterMac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAC: 00:1A:2B:3C:4D:5E"
        android:textColor="@color/texto"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRouterModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TP-Link Archer C20"
        android:textColor="@color/texto"
        android:textSize="14sp" />

</LinearLayout>